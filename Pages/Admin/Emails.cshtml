@page
@model ResumeApi.Pages.Admin.AdminEmailsModel
@{
    ViewData["Title"] = "Captured Emails";
}

<!-- Sticky Admin Actions (optional but nice) -->
<div class="sticky-top bg-white border-bottom shadow-sm" style="z-index: 1020;">
    <div class="container py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Admin / Captured Emails</span>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="/">Home</a>
            <a class="btn btn-outline-secondary btn-sm" href="/Resume">Resume</a>
        </div>
    </div>
</div>

<section class="container mt-4">

    @* Success message *@
    @if (TempData["Message"] is string msg && !string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-success shadow-sm">@msg</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h1 class="h3 mb-1">Captured Emails</h1>
                    <p class="text-muted mb-0">
                        Emails entered to access the resume (temporary, in-memory storage).
                    </p>
                </div>

                <div class="text-md-end">
                    <span class="badge rounded-pill text-bg-dark">
                        Total: @(Model.Emails?.Count ?? 0)
                    </span>
                </div>
            </div>

            @if (Model.Emails == null || Model.Emails.Count == 0)
            {
                <div class="alert alert-light border mb-0">
                    No emails have been captured yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>Email</th>
                                <th class="text-end" style="width: 220px;">Quick Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Emails.Count; i++)
                            {
                                var email = Model.Emails[i];
                                var subject = Uri.EscapeDataString("ResumeAPI - Thanks for viewing my resume");

                                <tr>
                                    <td class="text-muted">@(i + 1)</td>
                                    <td class="fw-semibold">@email</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary"
                                           href="mailto:@email?subject=@subject">
                                            Email
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-muted small">
                    Note: emails are stored in memory and will clear when the app restarts/recycles.
                </div>
            }

        </div>
    </div>
</section>
