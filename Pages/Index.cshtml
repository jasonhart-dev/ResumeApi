@page
@model ResumeApi.Pages.IndexModel
@{
    ViewData["Title"] = "Welcome";
    var emailSubject = Uri.EscapeDataString("Home Page Inquery");
}

<!-- HERO (Portfolio Bold) -->
<section class="bg-dark text-light py-5 rounded-3 shadow-sm">
    <div class="container text-center py-5">
        <h1 class="display-4 fw-bold mb-2">Jason Hart's Resume API Demo Application</h1>
        <p class="lead text-secondary mt-3 mb-4">
            A C# / ASP.NET Core portfolio project showcasing REST APIs, Swagger documentation,
            and a clean resume-driven web interface.
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a class="btn btn-primary btn-lg px-4" href="/Resume">View Resume</a>
            <a class="btn btn-outline-light btn-lg px-4" href="/swagger">Swagger API</a>
            <a class="btn btn-outline-light btn-lg px-4" href="/About">About Me</a>
            <a class="btn btn-outline-light btn-lg px-4" href="https://github.com/jasonhart-dev/ResumeApi" target="_blank">GitHub</a>
            <a class="btn btn-outline-light btn-lg px-4" href="/api/meta" target="_blank">API Meta</a>

        </div>
    </div>
</section>

<!-- WHY THIS PROJECT -->
<section class="container mt-5">
    <div class="row g-4">
        <div class="col-md-12">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Why This Project?</h2>
                    <p class="text-muted mb-3">
                        This site demonstrates modern .NET API development by exposing resume data
                        through versioned REST endpoints while also providing a simple UI for recruiters.
                    </p>

                    <ul class="mb-0">
                        <li>ASP.NET Core Web API with versioned endpoints (v2)</li>
                        <li>Self-describing API metadata endpoint (<code>/api/meta</code>)</li>
                        <li>REST endpoints exposing resume and recruiter interaction data</li>
                        <li>Swagger / OpenAPI documentation for interactive API testing</li>
                        <li>Razor Pages UI enhanced with Bootstrap for a modern, responsive experience</li>
                        <li>Intentional UX patterns (gated access, sticky actions, progressive disclosure)</li>
                        <li>Admin view for captured recruiter interest (in-memory, ephemeral storage)</li>
                        <li>GitHub source control with incremental, feature-focused commits</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

