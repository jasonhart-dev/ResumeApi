                    </div>
                </div>

                <div class="col-md-6">
                    <h3 class="h6 text-secondary fw-semibold mb-2">Architecture & Patterns</h3>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-secondary">MVC / Razor Pages</span>
                        <span class="badge bg-secondary">Dependency Injection</span>
                        <span class="badge bg-secondary">RESTful API Design</span>
                        <span class="badge bg-secondary">API Versioning</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- THANK YOU + EMAIL NOTICE -->
<section class="container mt-4">
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3">Thank you</h2>
                    <p class="text-muted mb-0">
                        This project reflects my background building, modernizing, and supporting
                        production .NET applications and APIs.
                        <br /><br />
                        Feel free to explore the code, test the endpoints, or reach out directly.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="alert alert-light shadow-sm h-100 mb-0" role="alert">
                <strong>Email Access Notice - NOT REQUIRED</strong><br />
                This site uses a lightweight email entry instead of a full login.
                Entering your email allows access to the resume and helps track genuine interest.
                Emails are stored temporarily and are not shared or used for marketing.
            

            <details class="mt-3">
                <summary class="text-secondary" style="cursor: pointer;">
                    Technical details
                </summary>

                <div class="mt-2 text-muted">
                    <p>
                        This site intentionally avoids a full authentication system.
                        A simple email entry is used to gate resume access and reduce friction.
                    </p>

                    <p class="mb-0">
                        Emails are stored in memory only and cleared automatically when the service restarts.
                        The application is recycled every six hours via an automated Azure schedule.
                    </p>
                </div>
            </details>
        </div>
    </div>
</section>

<!-- EMAIL FORM -->
<section class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Access</h2>

            <form method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div class="col-md-8">
                    <label class="form-label">Email address:</label>
                    <input asp-for="Email" name="Email" type="email" class="form-control" required />
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Continue</button>
                </div>
            </form>

            <div class="mt-3">
                <a class="btn btn-outline-secondary" href="/admin/emails">Admin Email Capture Page</a>
            </div>

            @if (!string.IsNullOrEmpty(TempData["Message"] as string))
            {
                <div class="alert alert-success mt-3 mb-0">
                    <strong>@TempData["Message"]</strong>
                </div>
            }
        </div>
    </div>
</section>

<!-- CONTACT ME -->
<section class="container mt-4">
    <div class="card shadow-sm h-100">
        <div class="card-body">
            <h2 class="h5 mb-3">Contact me!</h2>
