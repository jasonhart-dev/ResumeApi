@page
@model ResumeApi.Pages.IndexModel
@{
	ViewData["Title"] = "Welcome";
}

<div class="text-center mt-5">
	<h1 class="display-5">Jason Hart's Resume API Demo Applicatoion</h1>
	<p class="lead" mt-3>
		A C# / ASP.NET Core portfolio project showcasing REST APIs, Swagger documentation,
		and a clean resume-driven web interface.
	</p>

</div>

<p class="mt-2">
	Contact me!
	<a href="mailto:j24hart@gmail.com">
		j24hart@gmail.com
	</a>
</p>

 <a href="/files/JasonHartResume12-29-25API.docx" download>
     Download Resume (DOCX)
 </a>

<h2>Why This Project?</h2>
<p>
	This site demonstrates modern .NET API development by exposing resume data
	through versioned REST endpoints while also providing a simple UI for recruiters.
</p>

<ul>
	<li>ASP.NET Core Web API</li>
	<li>API versioning (v2)</li>
	<li>Swagger / OpenAPI documentation</li>
	<li>REST endpoints for resume content</li>
	<li>Recruiter inquiry POST endpoint</li>
	<li>Razor Pages front-end</li>
	<li>GitHub source control with feature branching and incremental commits</li>
</ul>

<h2>How to Explore This Site?</h2>
<p>
	This site demonstrates modern .NET API development by exposing resume data
	through versioned REST endpoints while also providing a simple UI for recruiters.
</p>

<ul>
	<li><a class="btn btn-primary m-1" href="/Resume">View Resume</a> – Browse resume content through the UI</li>
	<li><a class="btn btn-outline-secondary m-1" href="/swagger">Swagger API</a> – Test API endpoints directly in your browser</li>
	<li><a class="btn btn-outline-secondary m-1" href="https://github.com/jasonhart-dev/ResumeApi" target="_blank">GitHub</a> – Review the full source code</li>
	<li><a class="btn btn-primary m-1" href="/About">About Me</a> – A little more info about me!</li>
</ul>

<h2>Thank you</h2>
<p>
	This project reflects my background building, modernizing, and supporting
	production .NET applications and APIs.

	Feel free to explore the code, test the endpoints, or reach out directly.
</p>

<div class="alert alert-light mt-4" role="alert" style="max-width: 760px;">
	<strong>Email Access Notice - NOT REQUIRED</strong><br />
	This site uses a lightweight email entry instead of a full login.
	Entering your email allows access to the resume and helps track genuine interest.
	Emails are stored temporarily and are not shared or used for marketing.
</div>
<details class="mt-3" style="max-width: 760px;">
	<summary class="text-secondary" style="cursor: pointer;">
		Technical details
	</summary>

	<div class="mt-2 text-muted">
		<p>
			This site intentionally avoids a full authentication system.
			A simple email entry is used to gate resume access and reduce friction.
		</p>

		<p>
			Emails are stored in memory only and cleared automatically when the service restarts.
			The application is recycled every six hours via an automated Azure schedule.
		</p>
	</div>
</details>

<br />

<form method="post">
	@Html.AntiForgeryToken()
	<label>Email address:</label></<br />
	<input asp-for="Email" name="Email" type="email" required />
	</<br /></<br />
	<button type="submit">Continue</button>
</form>

<div class="mt-3">
<a class="btn btn-outline-secondary m-1" href="/admin/emails">Admin Email Capture Page</a>
</div>

@if (!string.IsNullOrEmpty(TempData["Message"] as string))
{
	<p style="color:green; font-weight:bold"><strong>@TempData["Message"]</strong></p>
}


