<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Jason Hart's ResumeAPI</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-page="/Index">ResumeAPI</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Resume">Resume</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
                <li class="nav-item"><a class="nav-link" href="/swagger">Swagger</a></li>
                <li class="nav-item"><a class="nav-link" href="https://github.com/jasonhart-dev/ResumeApi" target="_blank">GitHub</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    @RenderBody()
</main>

<footer class="border-top py-4 mt-5">
    <div class="container text-center text-muted small">
        © @DateTime.Now.Year Jason Hart • Built with ASP.NET Core
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
