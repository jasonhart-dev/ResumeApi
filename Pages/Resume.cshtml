@page
@model ResumeApi.Pages.ResumeModel
@{
    ViewData["Title"] = "Resume";
    var viewingFor = TempData["ViewingFor"] as string;
    var emailSubjectHire = Uri.EscapeDataString("Hiring Inquery");
    var emailSubjectResume = Uri.EscapeDataString("Resume Inquery");
}

<!-- Sticky Resume Actions -->
<div class="sticky-top bg-white border-bottom shadow-sm" style= z-index: 1020;">
    <div class="container py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Resume</span>

        <a class="btn btn-primary btn-sm"
           href="/files/JasonHartResume12-29-25API.docx"
           download>
            Download Resume
        </a>
    </div>
</div>


<!-- Header / Summary -->
<section class="mb-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                <div>
                    <h1 class="h2 mb-1">@Model.Summary?.Name</h1>
                    <div class="text-muted fs-5">@Model.Summary?.Title</div>
                    <!-- Core Skills -->
                    <div class="mt-3 d-flex flex-wrap gap-2">
                        <span class="badge rounded-pill text-bg-primary">C#</span>
                        <span class="badge rounded-pill text-bg-primary">ASP.NET Core</span>
                        <span class="badge rounded-pill text-bg-primary">Web API</span>

                        <span class="badge rounded-pill text-bg-secondary">SQL Server</span>
                        <span class="badge rounded-pill text-bg-secondary">ADO.NET</span>
                        <span class="badge rounded-pill text-bg-secondary">T-SQL</span>

                        <span class="badge rounded-pill text-bg-dark">Azure</span>
                        <span class="badge rounded-pill text-bg-dark">Swagger / OpenAPI</span>
                        <span class="badge rounded-pill text-bg-dark">Razor Pages</span>

                        <span class="badge rounded-pill text-bg-light text-dark border">WinForms</span>
                        <span class="badge rounded-pill text-bg-light text-dark border">VB.NET</span>
                        <span class="badge rounded-pill text-bg-light text-dark border">VBA</span>
                    </div>

                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-outline-primary" href="/files/Jason_Hart_Resume_12_30_API.docx" download>
                        Download Resume (DOCX)
                    </a>

                    @if (!Model.ShowHireMeForm)
                    {
                        <form method="post" asp-page-handler="ShowHireMe" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary">
                                Hire Me
                            </button>
                        </form>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Summary?.ProfessionalSummary))
            {
                <p class="mt-3 mb-0 text-muted">
                    @Model.Summary!.ProfessionalSummary
                </p>
            }
        </div>
    </div>
</section>

<!-- Messages -->
@if (TempData["Message"] is string msg && !string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-success shadow-sm">@msg</div>
}

@if (!string.IsNullOrWhiteSpace(viewingFor))
{
    <div class="alert alert-info shadow-sm">
        Viewing for: <strong>@viewingFor</strong>
    </div>
}

<!-- Hire Me Form -->
@if (Model.ShowHireMeForm)
{
    <section class="mb-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Hire Me</h2>
                <p class="text-muted mb-3">
                    Tell me what role you’re considering, and I’ll log your interest.
                </p>

                <form method="post" asp-page-handler="HireMe" class="row g-3">
                    @Html.AntiForgeryToken()

                    <div class="col-md-6">
                        <label class="form-label">Company</label>
                        <input class="form-control" asp-for="Company" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Job Title</label>
                        <input class="form-control" asp-for="JobTitle" />
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Submit</button>

                        <form method="post" asp-page-handler="Logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary">Cancel / Log out</button>
                        </form>
                    </div>
                </form>

                <div class="mt-3 text-muted small">
                    Prefer to reach out directly?
                    <a href="mailto:j24hart@gmail.com?subject=@emailSubjectHire">j24hart@gmail.com</a>
                </div>
            </div>
        </div>
    </section>
}

<!-- Experience Accordion -->
<section>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h2 class="h4 mb-3">Professional Experience</h2>

            <div class="accordion" id="expAccordion">
                @for (int i = 0; i < Model.Experiences.Count; i++)
                {
                    var exp = Model.Experiences[i];
                    var headingId = $"heading{i}";
                    var collapseId = $"collapse{i}";
                    var isFirst = i == 0;

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@collapseId">
                                <div class="w-100">
                                    <div class="fw-semibold">@exp.Title</div>
                                    <div class="small text-muted">
                                        @exp.Company • @exp.DateRange • @exp.Location
                                    </div>
                                </div>
                            </button>
                        </h2>

                        <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")"
                             aria-labelledby="@headingId" data-bs-parent="#expAccordion">
                            <div class="accordion-body">
                                @if (exp.Responsibilities != null && exp.Responsibilities.Count > 0)
                                {
                                    <ul class="mb-3">
                                        @foreach (var r in exp.Responsibilities)
                                        {
                                            <li>@r</li>
                                        }
                                    </ul>
                                }

                                @if (exp.Environment != null && exp.Environment.Length > 0)
                                {
                                    <details>
                                        <summary class="text-secondary">View Environment Details</summary>
                                        <ul class="mt-2">
                                            @foreach (var item in exp.Environment)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4 text-muted">
                Contact: <a href="mailto:j24hart@gmail.com?subject=@emailSubjectResume">j24hart@gmail.com</a>
            </div>
        </div>
    </div>
</section>
