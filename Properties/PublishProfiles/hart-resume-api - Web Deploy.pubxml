<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <ResourceId>/subscriptions/ea62aa57-4eef-43c9-a21d-41026b006142/resourceGroups/HartResumeApiResourceGroup/providers/Microsoft.Web/sites/hart-resume-api</ResourceId>
    <ResourceGroup>HartResumeApiResourceGroup</ResourceGroup>
    <PublishProvider>AzureWebSite</PublishProvider>
